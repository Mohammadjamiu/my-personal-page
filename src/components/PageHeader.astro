---
interface Props {
  label?: string;
  title: string;
  description?: string;
  meta?: string;
}

const { label, title, description, meta } = Astro.props;
---

<header class="mb-10 animate-fade-up">
  {label && <p class="section-eyebrow mb-3">{label}</p>}
  <h1 class="section-title mb-3">{title}</h1>
  {description && (
    <p class="text-base text-ink-muted max-w-2xl leading-relaxed">{description}</p>
  )}
  {meta && (
    <p class="mt-2 text-sm text-ink-subtle font-medium">{meta}</p>
  )}
</header>
