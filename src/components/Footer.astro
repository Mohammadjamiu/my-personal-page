---
const year = new Date().getFullYear();

const socialLinks = [
  {
    label: 'X / Twitter',
    href: 'https://twitter.com/mohammadjamiu',
    icon: `<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>`,
  },
  {
    label: 'GitHub',
    href: 'https://github.com/Mohammadjamiu',
    icon: `<path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>`,
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/in/mohammad-jamiu-balogun/',
    icon: `<path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd"/>`,
  },
];
---

<footer class="mt-auto border-t border-border bg-background">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-14">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-sm space-y-4">
        <a href="/" class="inline-flex items-center gap-2 group">
          <span class="flex h-8 w-8 items-center justify-center border border-border bg-foreground font-serif text-sm font-bold text-background">MJ</span>
          <span class="font-serif text-base font-semibold text-foreground">Mohammad Jamiu</span>
        </a>
        <p class="text-sm leading-relaxed text-muted-foreground">
          AI security researcher, engineer, and founder. Writing on LLMs, security, software, and finance — from Kano, Nigeria.
        </p>
        <div class="flex flex-wrap gap-4">
          {socialLinks.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="text-muted-foreground transition-colors hover:text-primary"
            >
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" set:html={s.icon} aria-hidden="true" />
            </a>
          ))}
        </div>
      </div>

      <div class="grid grid-cols-2 gap-10 text-sm sm:gap-16">
        <div>
          <h3 class="section-eyebrow mb-3">Navigate</h3>
          <ul class="space-y-2">
            {[
              { href: '/articles', label: 'Note' },
              { href: '/package-radar', label: 'Radar' },
              { href: '/projects', label: 'Projects' },
              { href: '/about', label: 'About' },
              { href: '/rss.xml', label: 'RSS' },
            ].map((l) => (
              <li>
                <a href={l.href} class="text-muted-foreground underline decoration-transparent underline-offset-4 hover:text-primary hover:decoration-primary">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="section-eyebrow mb-3">Topics</h3>
          <ul class="space-y-2">
            {[
              { href: '/category/personal-finance', label: 'Finance' },
              { href: '/category/dev-notes', label: 'Dev notes' },
              { href: '/category/ai', label: 'AI & ML' },
              { href: '/category/cybersecurity', label: 'Security' },
              { href: '/category/research', label: 'Research' },
            ].map((l) => (
              <li>
                <a href={l.href} class="text-muted-foreground underline decoration-transparent underline-offset-4 hover:text-primary hover:decoration-primary">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-2 border-t border-border pt-8 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Mohammad Jamiu</p>
      <p>
        Built with <a href="https://astro.build" class="underline decoration-border underline-offset-4 hover:text-primary hover:decoration-primary">Astro</a>
      </p>
    </div>
  </div>
</footer>
