---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { packageRadarEntries } from '@/data/package-radar';

const count = packageRadarEntries.length;
---

<Layout
  title="Package radar — Mohammad Jamiu"
  description="A living list of libraries and tools worth remembering — links, repos, and short notes. Expand each row for details."
>
  <Header />

  <main class="flex-grow">
    <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
      <PageHeader
        label="Toolbox"
        title="Package radar"
        description="Libraries and tools I use or am evaluating — expand a row for a short summary, reminders, and links to the site and source code."
        meta={`${count} ${count === 1 ? 'entry' : 'entries'}`}
      />

      <div class="space-y-3">
        {
          packageRadarEntries.map((pkg) => (
            <details class="package-radar-details group border border-border bg-background transition-colors open:border-primary/40 open:bg-muted/20">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-3 px-4 py-3.5 sm:px-5 sm:py-4 [&::-webkit-details-marker]:hidden">
                <div class="min-w-0 flex-1 text-left">
                  <span class="font-serif text-base font-semibold text-foreground sm:text-lg">{pkg.name}</span>
                  <span class="mt-0.5 block text-sm leading-snug text-muted-foreground">{pkg.tagline}</span>
                </div>
                <span
                  class="mt-1 shrink-0 font-sans text-[10px] font-semibold uppercase tracking-wider text-muted-foreground transition-colors group-open:text-primary"
                  aria-hidden="true"
                >
                  <span class="group-open:hidden">Open</span>
                  <span class="hidden group-open:inline">Close</span>
                </span>
              </summary>

              <div class="border-t border-border px-4 pb-4 pt-1 sm:px-5 sm:pb-5">
                <p class="mb-4 text-sm leading-relaxed text-muted-foreground">{pkg.summary}</p>

                <p class="section-eyebrow mb-2 text-[10px] font-semibold uppercase tracking-[0.18em] text-primary">Remember</p>
                <ul class="mb-5 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-muted-foreground">
                  {pkg.remember.map((line) => (
                    <li>{line}</li>
                  ))}
                </ul>

                {pkg.tags && pkg.tags.length > 0 && (
                  <div class="mb-5 flex flex-wrap gap-2">
                    {pkg.tags.map((t) => (
                      <span class="tag normal-case tracking-normal">{t}</span>
                    ))}
                  </div>
                )}

                <div class="flex flex-wrap gap-3 border-t border-border pt-4">
                  {pkg.links.website && (
                    <a
                      href={pkg.links.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link-arrow group inline-flex text-sm font-medium"
                    >
                      Website
                      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="h-3.5 w-3.5" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  )}
                  {pkg.links.github && (
                    <a
                      href={pkg.links.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground"
                    >
                      <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path
                          fill-rule="evenodd"
                          d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                          clip-rule="evenodd"
                        />
                      </svg>
                      Repository
                    </a>
                  )}
                  {pkg.links.docs && (
                    <a
                      href={pkg.links.docs}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link-arrow group inline-flex text-sm font-medium"
                    >
                      Docs
                      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="h-3.5 w-3.5" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .package-radar-details summary:focus {
    outline: none;
  }
  .package-radar-details summary:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
</style>
